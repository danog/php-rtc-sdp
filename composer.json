{
  "name": "quasarstream/sdp",
  "type": "library",
  "description": "A PHP library for parsing and generating SDP (Session Description Protocol).",
  "keywords": [
    "rtp",
    "sdp"
  ],
  "homepage": "https://www.quasarstream.com/webrtc",
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Amin Yazdanpanah",
      "email": "github@aminyazdanpanah.com"
    },
    {
      "name": "Sana Moniri",
      "email": "s.mo@quasarstream.com"
    },
    {
      "name": "Quasar Stream Community",
      "homepage": "https://quasarstream.com/teams"
    }
  ],
  "require": {
    "php": "^8.4",
    "quasarstream/exception": "^1.0",
    "quasarstream/dtls": "^1.0"
  },
  "require-dev": {
    "phpunit/php-code-coverage": "11.0.x-dev",
    "phpunit/phpunit": "^11.3"
  },
  "autoload": {
    "psr-4": {
      "Webrtc\\SDP\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\Webrtc\\SDP\\": "tests"
    }
  },
  "minimum-stability": "dev"
}