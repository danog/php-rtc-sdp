{
    "name": "danog/php-rtc-sdp",
    "type": "library",
    "description": "A PHP library for parsing and generating SDP (Session Description Protocol). Fork with FFI made optional and a pure-PHP DTLS/SRTP stack, maintained for MadelineProto.",
    "keywords": [
        "rtp",
        "sdp"
    ],
    "homepage": "https://www.quasarstream.com/webrtc",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Amin Yazdanpanah",
            "email": "github@aminyazdanpanah.com"
        },
        {
            "name": "Sana Moniri",
            "email": "s.mo@quasarstream.com"
        },
        {
            "name": "Quasar Stream Community",
            "homepage": "https://quasarstream.com/teams"
        }
    ],
    "require": {
        "php": "^8.2",
        "quasarstream/exception": "^1.0",
        "quasarstream/rtp-parameter": "^1.0",
        "quasarstream/ice": "^1.0",
        "symfony/polyfill-php84": "^1.32"
    },
    "require-dev": {
        "phpunit/php-code-coverage": "11.0.x-dev",
        "phpunit/phpunit": "^11.3"
    },
    "autoload": {
        "psr-4": {
            "Webrtc\\SDP\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Webrtc\\SDP\\": "tests"
        }
    },
    "minimum-stability": "dev",
    "replace": {
        "quasarstream/sdp": "self.version"
    }
}
