{
    "name": "danog/php-rtc-sdp",
    "type": "library",
    "description": "SDP parsing and generation for PHP WebRTC. MadelineProto's PHP 8.2+ fork is a Composer-compatible component of the modular danog/php-rtc stack.",
    "keywords": [
        "rtp",
        "sdp"
    ],
    "homepage": "https://github.com/danog/php-rtc-sdp",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Amin Yazdanpanah",
            "email": "github@aminyazdanpanah.com"
        },
        {
            "name": "Sana Moniri",
            "email": "s.mo@quasarstream.com"
        },
        {
            "name": "Quasar Stream Community"
        },
        {
            "name": "Daniil Gentili",
            "email": "daniil@daniil.it"
        }
    ],
    "require": {
        "php": "^8.2",
        "danog/php-rtc-exception": "^1.0",
        "danog/php-rtc-rtp-parameter": "^1.0",
        "danog/php-rtc-ice": "^1.0",
        "symfony/polyfill-php84": "^1.32"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Webrtc\\SDP\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Webrtc\\SDP\\": "tests"
        }
    },
    "minimum-stability": "stable"
}
